# ===== Database =====
DATABASE_URL="postgresql://vendas:secret@localhost:5432/vendas_black?schema=public"

# ===== JWT =====
# Troque por um segredo forte em producao (min. 32 chars)
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRATION="7d"

# ===== Redis =====
REDIS_HOST="localhost"
REDIS_PORT="6379"

# ===== MinIO (S3 compatible) =====
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_USE_SSL="false"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="vendas-uploads"
# URL pública usada nos links das imagens (CDN/domínio em produção)
# MINIO_PUBLIC_URL="https://uploads.seudominio.com"

# ===== Email (SMTP) =====
# Em dev, use o Mailhog: http://localhost:8025
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@vendasblack.com"

# ===== App =====
PORT=3001
NODE_ENV="development"
FRONTEND_URL="http://localhost:3000"

# ===== Seed =====
SUPER_ADMIN_EMAIL="admin@vendasblack.com"
SUPER_ADMIN_PASSWORD="Admin@123"
