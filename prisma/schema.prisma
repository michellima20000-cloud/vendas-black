generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  STORE_OWNER
  CUSTOMER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  BOLETO
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(CUSTOMER)
  avatar    String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store    Store?
  orders   Order[]
  sessions Session[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Store {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String?
  about       String?
  logoUrl     String?
  bannerUrl   String?
  instagram   String?
  whatsapp    String?
  couponCode  String?
  couponValue Float?
  isActive    Boolean  @default(true)
  ownerId     String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner        User          @relation(fields: [ownerId], references: [id])
  products     Product[]
  orders       Order[]
  theme        StoreTheme?
  howToBuy     HowToBuy[]
  testimonials Testimonial[]
  categories   Category[]

  @@map("stores")
}

model StoreTheme {
  id           String @id @default(uuid())
  storeId      String @unique
  primaryColor String @default("#B07A85")
  accentColor  String @default("#F4A3BA")
  bgColor      String @default("#FFF1F5")
  fontTitle    String @default("Playfair Display")
  fontBody     String @default("Nunito")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("store_themes")
}

model HowToBuy {
  id       String @id @default(uuid())
  storeId  String
  step     Int
  icon     String
  title    String
  subtitle String

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("how_to_buy")
}

model Category {
  id        String    @id @default(uuid())
  storeId   String
  name      String
  slug      String
  createdAt DateTime  @default(now())

  store    Store     @relation(fields: [storeId], references: [id])
  products Product[]

  @@unique([storeId, slug])
  @@map("categories")
}

model Product {
  id           String   @id @default(uuid())
  storeId      String
  categoryId   String?
  name         String
  description  String?
  price        Float
  comparePrice Float?
  images       String[]
  isActive     Boolean  @default(true)
  stock        Int      @default(0)
  installments Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  store      Store              @relation(fields: [storeId], references: [id])
  category   Category?          @relation(fields: [categoryId], references: [id])
  variations ProductVariation[]
  orderItems OrderItem[]

  @@map("products")
}

model ProductVariation {
  id        String @id @default(uuid())
  productId String
  type      String
  value     String
  stock     Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_variations")
}

model Order {
  id            String         @id @default(uuid())
  storeId       String
  customerId    String?
  status        OrderStatus    @default(PENDING)
  paymentMethod PaymentMethod?
  total         Float
  discount      Float          @default(0)
  couponCode    String?
  notes         String?
  whatsappSent  Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  store    Store       @relation(fields: [storeId], references: [id])
  customer User?       @relation(fields: [customerId], references: [id])
  items    OrderItem[]
  address  Address?

  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  quantity  Int
  price     Float
  variation String?

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model Address {
  id         String  @id @default(uuid())
  orderId    String  @unique
  street     String
  number     String
  complement String?
  district   String
  city       String
  state      String
  zipCode    String

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("addresses")
}

model Testimonial {
  id        String   @id @default(uuid())
  storeId   String
  author    String
  text      String
  rating    Int      @default(5)
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("testimonials")
}
